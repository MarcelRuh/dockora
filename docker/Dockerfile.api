# syntax=docker/dockerfile:1

FROM node:22-bookworm-slim AS base
RUN apt-get update \
 && apt-get install -y --no-install-recommends openssl ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* turbo.json ./
COPY packages/tsconfig ./packages/tsconfig
COPY packages/shared/package.json ./packages/shared/
COPY apps/api/package.json ./apps/api/
RUN pnpm install --filter @dockora/api... --frozen-lockfile || pnpm install --filter @dockora/api...

FROM base AS build
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages ./packages
COPY --from=deps /app/apps/api ./apps/api
COPY --from=deps /app/package.json /app/pnpm-workspace.yaml /app/turbo.json ./
COPY packages/shared ./packages/shared
COPY apps/api ./apps/api
RUN pnpm --filter @dockora/shared build \
 && pnpm --filter @dockora/api exec prisma generate \
 && pnpm --filter @dockora/api build

FROM node:22-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
LABEL org.opencontainers.image.source="https://github.com/MarcelRuh/dockora"
LABEL org.opencontainers.image.title="dockora-api"
LABEL org.opencontainers.image.description="Dockora API"
RUN apt-get update && apt-get install -y --no-install-recommends wget ca-certificates openssl \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd -r dockora && useradd -r -g dockora dockora
COPY --from=build /app/packages/shared /app/packages/shared
COPY --from=build /app/apps/api/dist /app/apps/api/dist
COPY --from=build /app/apps/api/package.json /app/apps/api/
COPY --from=build /app/apps/api/prisma /app/apps/api/prisma
COPY --from=build /app/apps/api/node_modules /app/apps/api/node_modules
COPY --from=build /app/node_modules /app/node_modules
COPY docker/api-entrypoint.sh /entrypoint.sh
RUN mkdir -p /data /data/compose /home /srv \
 && chown -R dockora:dockora /data /app \
 && chmod +x /entrypoint.sh
WORKDIR /app/apps/api
EXPOSE 3001
USER root
ENTRYPOINT ["/entrypoint.sh"]
