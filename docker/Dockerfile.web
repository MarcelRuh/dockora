# syntax=docker/dockerfile:1

FROM node:22-bookworm-slim AS base
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* turbo.json ./
COPY packages/tsconfig ./packages/tsconfig
COPY packages/shared/package.json ./packages/shared/
COPY apps/web/package.json ./apps/web/
RUN pnpm install --filter @dockora/web... --frozen-lockfile || pnpm install --filter @dockora/web...

FROM base AS build
ARG DOCKORA_API_URL=http://api:3001
ENV DOCKORA_API_URL=$DOCKORA_API_URL
COPY --from=deps /app ./
COPY packages/tsconfig ./packages/tsconfig
COPY packages/shared/src ./packages/shared/src
COPY packages/shared/package.json packages/shared/tsconfig.json ./packages/shared/
COPY apps/web/src ./apps/web/src
COPY apps/web/public ./apps/web/public
COPY apps/web/package.json apps/web/tsconfig.json apps/web/next.config.ts \
     apps/web/tailwind.config.js apps/web/postcss.config.js apps/web/next-env.d.ts \
     apps/web/vitest.config.ts ./apps/web/
RUN pnpm install --filter @dockora/web... --offline --frozen-lockfile \
 || pnpm install --filter @dockora/web... --frozen-lockfile \
 && pnpm --filter @dockora/shared build \
 && pnpm --filter @dockora/web build

FROM node:22-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
LABEL org.opencontainers.image.source="https://github.com/MarcelRuh/dockora"
LABEL org.opencontainers.image.title="dockora-web"
LABEL org.opencontainers.image.description="Dockora Web UI"
RUN groupadd -r dockora && useradd -r -g dockora dockora
COPY --from=build /app/apps/web/.next/standalone ./
COPY --from=build /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /app/apps/web/public ./apps/web/public
USER dockora
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
