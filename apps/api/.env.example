# Dockora API – Environment Template
# Copy to apps/api/.env and adjust. Never commit real secrets.

NODE_ENV=development
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info

# SQLite – path is relative to apps/api/prisma (Prisma convention)
# Creates <repo>/data/dockora.db when you mkdir -p data from the repo root.
DATABASE_URL="file:../../../data/dockora.db"

# Backups – relative to process cwd (apps/api when using pnpm dev:api)
BACKUP_DIR=../../data/backups

# Docker Socket (grant only required host permissions)
DOCKER_SOCKET=/var/run/docker.sock

# CORS – Frontend origin
CORS_ORIGIN=http://localhost:3000

# JWT – production: ≥32 chars, no "change-me" defaults (API refuses to boot otherwise)
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=7d

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW_MS=60000

# Compose discovery (comma-separated)
COMPOSE_SEARCH_PATHS=/data/compose,/opt,/srv,/home
COMPOSE_EXCLUDE_PATHS=
IMAGE_EXCLUDE_PREFIXES=dockora

# Bootstrap admin (production: strong password ≥12 chars, no defaults)
BOOTSTRAP_ADMIN_EMAIL=admin@dockora.local
BOOTSTRAP_ADMIN_PASSWORD=dockora-admin-change-me
AUTO_UPDATE_ENABLED=false

# Optional: Dockora self-update
# Compose/GitHub (auto-detected from repo root in development):
# DOCKORA_INSTALL_DIR=/home/dockora
# DOCKORA_REPO=MarcelRuh/dockora
# DOCKORA_UPDATE_BRANCH=main
# Optional image mode:
# DOCKORA_SELF_IMAGE=ghcr.io/marcelruh/dockora-api:latest

# Optional: drop-in plugins (<dir>/<name>/index.js)
# PLUGIN_DIR=../../plugins
