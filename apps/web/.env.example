# Dockora Web
# Server-seitiger Rewrite-/Stream-Proxy-Zielhost
# DOCKORA_API_URL=http://127.0.0.1:3001

# Optional Dev: Browser direkt auf API-Port (SSE/WS).
# Ohne diese Vars: Same-Origin – SSE über Next Stream-Routes, WS über Host.
# Produktion: docker compose --profile proxy (nginx, siehe deploy/nginx.conf).
# NEXT_PUBLIC_API_HTTP=http://localhost:3001
# NEXT_PUBLIC_API_WS=ws://localhost:3001
