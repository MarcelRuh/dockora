# Root env for Compose / local orchestration
COMPOSE_PROJECT_NAME=dockora
DOCKORA_WEB_PORT=3000
DOCKORA_API_PORT=3001
DOCKORA_PROXY_PORT=8080

# REQUIRED in production – generate e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-in-production-use-long-random-string

CORS_ORIGIN=http://localhost:3000
COMPOSE_SEARCH_PATHS=/home,/opt,/srv,/data/compose
DOCKER_SOCKET=/var/run/docker.sock
# Host-GID der Gruppe `docker` (Socket-Zugriff im API-Container). Ermitteln: getent group docker
DOCKER_GID=999
DOCKER_GID=999

BOOTSTRAP_ADMIN_EMAIL=admin@dockora.local
# REQUIRED in production – min 12 chars, not a known default
BOOTSTRAP_ADMIN_PASSWORD=dockora-admin-change-me

# Optional browser → API direct (dev). Prefer proxy profile in production.
# NEXT_PUBLIC_API_HTTP=http://localhost:3001
# NEXT_PUBLIC_API_WS=ws://localhost:3001

# Optional self-update
# Compose-Install (Standard nach install.sh) – In-App unter Einstellungen → Updates
DOCKORA_INSTALL_DIR=/opt/dockora
DOCKORA_REPO=MarcelRuh/dockora
DOCKORA_UPDATE_BRANCH=main
# DOCKORA_GIT_SHA=
# Alternativ Image-Modus:
# DOCKORA_SELF_IMAGE=ghcr.io/marcelruh/dockora-api:latest

# Optional: GHCR images instead of local build
# DOCKORA_USE_IMAGES=1
DOCKORA_IMAGE_TAG=latest
# DOCKORA_API_IMAGE=ghcr.io/marcelruh/dockora-api:latest
# DOCKORA_WEB_IMAGE=ghcr.io/marcelruh/dockora-web:latest
